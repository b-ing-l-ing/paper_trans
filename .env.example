# DeepSeek（纯文本提取）
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini（多模态提取，可选）
GEMINI_API_KEY=your_key_here

# 默认模型
# DeepSeek 纯文本: deepseek-v4-flash / deepseek-v4-pro 等
# Gemini 多模态: gemini-3.6-flash / gemini-3.5-flash / gemini-3-flash-preview 等
PAPER_TRANS_MODEL=deepseek-v4-flash
PAPER_TRANS_MULTIMODAL_MODEL=gemini-3.6-flash

# 可选配置
# PAPER_TRANS_REVIEW_LIMIT=15000      # 审查时文本截断长度
# PAPER_TRANS_OUTPUT_DIR=./output     # 输出目录
# PAPER_TRANS_IMAGE_DIR=./output/images  # 图片目录
